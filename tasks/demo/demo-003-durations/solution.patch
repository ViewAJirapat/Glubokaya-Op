+"""Parse compact duration strings such as "1h30m"."""
+
+import re
+
+_UNIT_SECONDS = {"d": 86400, "h": 3600, "m": 60, "s": 1}
+_DURATION = re.compile(r"(?:(\d+)d)? *(?:(\d+)h)? *(?:(\d+)m)? *(?:(\d+)s)?")
+
+
+def parse_duration(text: str) -> int:
+    """Convert e.g. "2d 3h" or "1h30m" into seconds. Raises ValueError on bad input."""
+    stripped = text.strip()
+    match = _DURATION.fullmatch(stripped)
+    if not stripped or match is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    return sum(
+        int(value) * seconds
+        for value, seconds in zip(match.groups(), _UNIT_SECONDS.values(), strict=True)
+        if value is not None
+    )
