diff --git a/src/shopkit/pricing.py b/src/shopkit/pricing.py
index 8c280f6..3def647 100644
--- a/src/shopkit/pricing.py
+++ b/src/shopkit/pricing.py
@@ -1,7 +1,19 @@
 """Money math. All amounts are integer cents."""
 
+DISCOUNT_CODES: dict[str, int] = {"SAVE10": 10, "SAVE25": 25, "HALF": 50}
+
 
 def line_total(unit_price_cents: int, quantity: int) -> int:
     if quantity < 0:
         raise ValueError("quantity must be >= 0")
     return unit_price_cents * quantity
+
+
+def apply_discount(amount_cents: int, percent: int) -> int:
+    """Take `percent`% off `amount_cents`, rounding the discount half up to whole cents."""
+    if not 0 <= percent <= 100:
+        raise ValueError("percent must be between 0 and 100")
+    if amount_cents < 0:
+        raise ValueError("amount_cents must be >= 0")
+    discount = (amount_cents * percent + 50) // 100
+    return amount_cents - discount
