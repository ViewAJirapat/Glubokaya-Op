+from shopapi.core.api import HTTPError, Request, Response, route
+from shopapi.features.roman.numerals import to_roman
+
+
+@route("GET", "/roman/{number}")
+def roman(request: Request) -> Response:
+    raw = request.params["number"]
+    if not (raw.isascii() and raw.isdigit()):
+        raise HTTPError(400, f"not a whole number: {raw!r}")
+    digits = raw.lstrip("0") or "0"
+    if len(digits) > 4:  # also keeps int() away from its 4300-digit limit
+        raise HTTPError(400, "number must be between 1 and 3999")
+    number = int(digits)
+    if not 1 <= number <= 3999:
+        raise HTTPError(400, "number must be between 1 and 3999")
+    return Response(200, {"number": number, "roman": to_roman(number)})
